<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shows the phone's own wallpaper behind the home screen. -->
    <style name="LauncherTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Black, instant, full screen: only the glowing border shows. -->
    <style name="EdgeTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Trash: the wallpaper shows through a dark glass, like the drawer. -->
    <style name="TrashTheme" parent="@style/LauncherTheme" />

    <!-- "Move to trash" from the share menu: no window of its own, only the system confirmation. -->
    <style name="InvisibleTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>
</resources>
