    <style name="CuerdaDialog" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/coral</item>
    </style>
    <color name="bg">#FFF6F1E4</color>
    <color name="coral">#FFE2574C</color>
    <color name="mango">#FFFFC24B</color>
</resources>
